# ============================================================================
# Continuum — environment template
# Copy to `.env` (root) and fill in real values. NEVER commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend (FastAPI) — backend/.env
# ---------------------------------------------------------------------------
# Postgres connection (SQLAlchemy 2 + psycopg3). Must point at PostgreSQL.
# Host port 5433 matches docker-compose.yml (5432 is often taken locally).
DATABASE_URL=postgresql+psycopg://continuum:continuum@localhost:5433/continuum

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development

# --- Supabase Auth -----------------------------------------------------------
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# JWT secret used to verify Supabase-issued access tokens.
# Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=
# Expected JWT audience for Supabase access tokens (usually "authenticated").
SUPABASE_JWT_AUDIENCE=authenticated
# Supabase service role key (server-side only, never exposed to the frontend).
SUPABASE_SERVICE_ROLE_KEY=
# Supabase anon/public key (safe for frontend, used by @supabase/supabase-js).
SUPABASE_ANON_KEY=

# --- Public demo mode (frictionless judge access) -----------------------
# Set to "true" (default) to serve token-less visitors as the read-only
# public-demo principal inside the synthetic Continuum Demo Workspace.
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_READ_ONLY=true

# --- Development auth bypass -------------------------------------------------
# When ENVIRONMENT=development you may set this to "true" to allow a
# dev-only static token (see README "Local authentication testing").
# MUST be false in production.
ALLOW_DEV_AUTH=false
DEV_AUTH_TOKEN=dev-local-token

# --- GitHub Integration --------------------------------------------------------
# Option A: Personal Access Token (PAT). Easiest for hackathons and automated deployments.
# E.g. ghp_...
GITHUB_TOKEN=
# Option B: GitHub OAuth App. Required for interactive multi-user OAuth redirect flow.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fernet key used to encrypt GitHub access tokens at rest (server-side only).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
# Must match the callback configured in the GitHub OAuth App settings.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
# Where the backend redirects the browser after a successful OAuth callback.
GITHUB_OAUTH_FRONTEND_REDIRECT=http://localhost:5173/sources

# --- Uploads -----------------------------------------------------------------
# Maximum upload size in bytes (default 25 MB).
MAX_UPLOAD_SIZE_BYTES=26214400
# Maximum expanded size for a single ZIP archive in bytes (default 100 MB).
MAX_ZIP_EXPANSION_BYTES=104857600
UPLOAD_DIR=./storage/uploads

# --- AI intelligence layer (Phase 3) -----------------------------------------
# Server-side only. NEVER expose this key to the frontend.
# Without GEMINI_API_KEY the reconstruction endpoints return HTTP 503 and the
# app reports that the intelligence layer is unconfigured — nothing is faked.
GEMINI_API_KEY=
# Model identifier is pinned through configuration, not hard-coded in agent code.
# Verify the model and free-tier quota for your key before a live run.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=8192

# ---------------------------------------------------------------------------
# Frontend (Vite) — frontend/.env
# ---------------------------------------------------------------------------
# VITE_ prefix => exposed to the browser. NEVER put secrets here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
