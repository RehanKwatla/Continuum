# ============================================================================
# Continuum frontend (Vite) — environment template
# Copy to `frontend/.env`. Everything prefixed with VITE_ is shipped to the
# browser: never place secrets here.
# ============================================================================

# Backend API root (FastAPI). Includes the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Supabase Auth (optional) ------------------------------------------------
# Leave blank to use the backend's development-only token flow instead.
# Supabase Dashboard -> Project Settings -> API -> Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Development-only auth ---------------------------------------------------
# Only used when Supabase is NOT configured AND the backend has
# ALLOW_DEV_AUTH=true. Must match the backend DEV_AUTH_TOKEN.
VITE_DEV_AUTH_TOKEN=dev-local-token
